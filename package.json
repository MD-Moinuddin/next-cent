{
  "name": "nextcent",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "api:openapi": "cd services/api && uv run python scripts/export_openapi.py",
    "api:client": "pnpm --filter @nextcent/api-client generate",
    "api:sync": "pnpm api:openapi && pnpm api:client"
  },
  "devDependencies": {
    "lefthook": "^2.2.3",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
