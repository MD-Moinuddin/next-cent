# NextCent environment reference. Placeholders only: never commit real secrets.
# Local use: `cp .env.example services/api/.env` (the API reads services/api/.env and ignores
# the EXPO_PUBLIC_* lines) and `cp apps/app/.env.example apps/app/.env` for the app.
# In production set these in the host's secret store instead of files.

# ---- API (services/api) ----
# Local Postgres from docker-compose.yml is on HOST port 5433 (container port 5432).
NEXTCENT_DATABASE_URL=postgresql+asyncpg://nextcent:nextcent@localhost:5433/nextcent
# Token issuer and JWKS URL of the auth provider (Clerk: Frontend API URL and its /.well-known/jwks.json).
NEXTCENT_AUTH_ISSUER=https://your-clerk-instance.clerk.accounts.dev
NEXTCENT_AUTH_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: expected `aud` claim. Keep this line COMMENTED OUT to skip audience checks (Clerk session tokens
# carry none by default). An empty value is also treated as unset.
# NEXTCENT_AUTH_AUDIENCE=
# Must be a JSON list (pydantic-settings parses it as JSON), e.g. ["http://localhost:8081","https://app.example.com"]
NEXTCENT_CORS_ORIGINS=["http://localhost:8081"]
# Shared secret for POST /internal/tasks/generate-recurring (X-Internal-Secret header). Use a long random value.
NEXTCENT_INTERNAL_TASK_SECRET=change-me-long-random-string
# Optional (defaults shown). Rate limit is per client IP and per API instance (in memory).
# NEXTCENT_RATE_LIMIT=300/minute
# NEXTCENT_MAX_BODY_BYTES=1048576
# NEXTCENT_ENVIRONMENT=local
# NEXTCENT_SENTRY_DSN=
# Read by uvicorn (not by the app). Which proxies' X-Forwarded-For is trusted. The Docker image
# defaults to 127.0.0.1. Set it to your platform proxy's IP/CIDR; use "*" only when the
# container is reachable exclusively through a trusted proxy that overwrites the header.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Optional (tests only): database used by `uv run pytest` (default localhost:5433/nextcent_test).
# NEXTCENT_TEST_DATABASE_URL=postgresql+asyncpg://nextcent:nextcent@localhost:5433/nextcent_test

# ---- App (apps/app) ----
# EXPO_PUBLIC_* values are inlined at BUILD time and visible to anyone who loads the app.
# Never put secrets in them. Production values live in the web host's / EAS's environment settings.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Clerk publishable key (pk_test_... for dev, pk_live_... for production).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Test-only. Replaces Clerk with a stub for Playwright. The build throws unless the output dir is
# dist-e2e; NEVER set this for a real build and never deploy dist-e2e.
# EXPO_PUBLIC_E2E_STUB_AUTH=1
