{
  "name": "@nextcent/app",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@clerk/expo": "^4.16.2",
    "@hookform/resolvers": "^7.0.6",
    "@nextcent/api-client": "workspace:*",
    "@nextcent/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "serve": "^14.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:web": "expo export -p web && node scripts/assert-no-e2e-stub.mjs dist",
    "build:web:e2e": "env EXPO_PUBLIC_E2E_STUB_AUTH=1 EXPO_PUBLIC_API_URL=http://localhost:8000 EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder expo export -p web --output-dir dist-e2e && node scripts/assert-no-e2e-stub.mjs dist-e2e --expect-stub",
    "e2e:run": "playwright test -c e2e/playwright.config.ts",
    "e2e": "pnpm run build:web:e2e && pnpm run e2e:run"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/",
      "<rootDir>/dist",
      "<rootDir>/dist-e2e/"
    ]
  }
}
